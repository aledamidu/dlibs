/// Loads the entry points required by a named extension, for example
/// "GL_EXT_texture_storage".  Unknown extension names are ignored.
void loadGLExtension(const(char)* name, GLProcLoader loader) @nogc nothrow {
    if (name is null || loader is null) return;
    if (glStreq(name, "GL_3DFX_tbuffer")) {
        _glTbufferMask3DFX = cast(PFNGLTBUFFERMASK3DFXPROC) loader("glTbufferMask3DFX");
        return;
    }
    if (glStreq(name, "GL_AMD_debug_output")) {
        _glDebugMessageEnableAMD = cast(PFNGLDEBUGMESSAGEENABLEAMDPROC) loader("glDebugMessageEnableAMD");
        _glDebugMessageInsertAMD = cast(PFNGLDEBUGMESSAGEINSERTAMDPROC) loader("glDebugMessageInsertAMD");
        _glDebugMessageCallbackAMD = cast(PFNGLDEBUGMESSAGECALLBACKAMDPROC) loader("glDebugMessageCallbackAMD");
        _glGetDebugMessageLogAMD = cast(PFNGLGETDEBUGMESSAGELOGAMDPROC) loader("glGetDebugMessageLogAMD");
        return;
    }
    if (glStreq(name, "GL_AMD_draw_buffers_blend")) {
        _glBlendFuncIndexedAMD = cast(PFNGLBLENDFUNCINDEXEDAMDPROC) loader("glBlendFuncIndexedAMD");
        _glBlendFuncSeparateIndexedAMD = cast(PFNGLBLENDFUNCSEPARATEINDEXEDAMDPROC) loader("glBlendFuncSeparateIndexedAMD");
        _glBlendEquationIndexedAMD = cast(PFNGLBLENDEQUATIONINDEXEDAMDPROC) loader("glBlendEquationIndexedAMD");
        _glBlendEquationSeparateIndexedAMD = cast(PFNGLBLENDEQUATIONSEPARATEINDEXEDAMDPROC) loader("glBlendEquationSeparateIndexedAMD");
        return;
