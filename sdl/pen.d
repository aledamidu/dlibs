module libs.sdl.pen;

import libs.sdl.mouse;
import libs.sdl.touch;

extern (C):
@nogc nothrow:

alias SDL_PenID = uint;

enum SDL_PEN_MOUSEID = cast(SDL_MouseID)-2;

enum SDL_PEN_TOUCHID = cast(SDL_TouchID)-2;

alias SDL_PenInputFlags = uint;

enum SDL_PEN_INPUT_DOWN = 1u << 0;
enum SDL_PEN_INPUT_BUTTON_1 = 1u << 1;
enum SDL_PEN_INPUT_BUTTON_2 = 1u << 2;
enum SDL_PEN_INPUT_BUTTON_3 = 1u << 3;
enum SDL_PEN_INPUT_BUTTON_4 = 1u << 4;
enum SDL_PEN_INPUT_BUTTON_5 = 1u << 5;
enum SDL_PEN_INPUT_ERASER_TIP = 1u << 30;
enum SDL_PEN_INPUT_IN_PROXIMITY = 1u << 31;

enum SDL_PenAxis
{
    SDL_PEN_AXIS_PRESSURE = 0,
    SDL_PEN_AXIS_XTILT = 1,
    SDL_PEN_AXIS_YTILT = 2,
    SDL_PEN_AXIS_DISTANCE = 3,
    SDL_PEN_AXIS_ROTATION = 4,
    SDL_PEN_AXIS_SLIDER = 5,
    SDL_PEN_AXIS_TANGENTIAL_PRESSURE = 6,
    SDL_PEN_AXIS_COUNT = 7
}

alias SDL_PEN_AXIS_PRESSURE = SDL_PenAxis.SDL_PEN_AXIS_PRESSURE;
alias SDL_PEN_AXIS_XTILT = SDL_PenAxis.SDL_PEN_AXIS_XTILT;
alias SDL_PEN_AXIS_YTILT = SDL_PenAxis.SDL_PEN_AXIS_YTILT;
alias SDL_PEN_AXIS_DISTANCE = SDL_PenAxis.SDL_PEN_AXIS_DISTANCE;
alias SDL_PEN_AXIS_ROTATION = SDL_PenAxis.SDL_PEN_AXIS_ROTATION;
alias SDL_PEN_AXIS_SLIDER = SDL_PenAxis.SDL_PEN_AXIS_SLIDER;
alias SDL_PEN_AXIS_TANGENTIAL_PRESSURE = SDL_PenAxis.SDL_PEN_AXIS_TANGENTIAL_PRESSURE;
alias SDL_PEN_AXIS_COUNT = SDL_PenAxis.SDL_PEN_AXIS_COUNT;

enum SDL_PenDeviceType
{
    SDL_PEN_DEVICE_TYPE_INVALID = -1,
    SDL_PEN_DEVICE_TYPE_UNKNOWN = 0,
    SDL_PEN_DEVICE_TYPE_DIRECT = 1,
    SDL_PEN_DEVICE_TYPE_INDIRECT = 2
}

alias SDL_PEN_DEVICE_TYPE_INVALID = SDL_PenDeviceType.SDL_PEN_DEVICE_TYPE_INVALID;
alias SDL_PEN_DEVICE_TYPE_UNKNOWN = SDL_PenDeviceType.SDL_PEN_DEVICE_TYPE_UNKNOWN;
alias SDL_PEN_DEVICE_TYPE_DIRECT = SDL_PenDeviceType.SDL_PEN_DEVICE_TYPE_DIRECT;
alias SDL_PEN_DEVICE_TYPE_INDIRECT = SDL_PenDeviceType.SDL_PEN_DEVICE_TYPE_INDIRECT;

pragma(mangle, "SDL_GetPenDeviceType")
SDL_PenDeviceType sdlGetPenDeviceType(SDL_PenID instance_id);

alias SDL_GetPenDeviceType = sdlGetPenDeviceType;
