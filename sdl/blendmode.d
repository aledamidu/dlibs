module libs.sdl.blendmode;
extern (C):
@nogc nothrow:

alias SDL_BlendMode = uint;

enum SDL_BLENDMODE_NONE = 0x00000000u;
enum SDL_BLENDMODE_BLEND = 0x00000001u;
enum SDL_BLENDMODE_BLEND_PREMULTIPLIED = 0x00000010u;
enum SDL_BLENDMODE_ADD = 0x00000002u;
enum SDL_BLENDMODE_ADD_PREMULTIPLIED = 0x00000020u;
enum SDL_BLENDMODE_MOD = 0x00000004u;
enum SDL_BLENDMODE_MUL = 0x00000008u;
enum SDL_BLENDMODE_INVALID = 0x7FFFFFFFu;

enum SDL_BlendOperation
{
    SDL_BLENDOPERATION_ADD = 0x1,
    SDL_BLENDOPERATION_SUBTRACT = 0x2,
    SDL_BLENDOPERATION_REV_SUBTRACT = 0x3,
    SDL_BLENDOPERATION_MINIMUM = 0x4,
    SDL_BLENDOPERATION_MAXIMUM = 0x5
}

alias SDL_BLENDOPERATION_ADD = SDL_BlendOperation.SDL_BLENDOPERATION_ADD;
alias SDL_BLENDOPERATION_SUBTRACT = SDL_BlendOperation.SDL_BLENDOPERATION_SUBTRACT;
alias SDL_BLENDOPERATION_REV_SUBTRACT = SDL_BlendOperation.SDL_BLENDOPERATION_REV_SUBTRACT;
alias SDL_BLENDOPERATION_MINIMUM = SDL_BlendOperation.SDL_BLENDOPERATION_MINIMUM;
alias SDL_BLENDOPERATION_MAXIMUM = SDL_BlendOperation.SDL_BLENDOPERATION_MAXIMUM;

enum SDL_BlendFactor
{
    SDL_BLENDFACTOR_ZERO = 0x1,
    SDL_BLENDFACTOR_ONE = 0x2,
    SDL_BLENDFACTOR_SRC_COLOR = 0x3,
    SDL_BLENDFACTOR_ONE_MINUS_SRC_COLOR = 0x4,
    SDL_BLENDFACTOR_SRC_ALPHA = 0x5,
    SDL_BLENDFACTOR_ONE_MINUS_SRC_ALPHA = 0x6,
    SDL_BLENDFACTOR_DST_COLOR = 0x7,
    SDL_BLENDFACTOR_ONE_MINUS_DST_COLOR = 0x8,
    SDL_BLENDFACTOR_DST_ALPHA = 0x9,
    SDL_BLENDFACTOR_ONE_MINUS_DST_ALPHA = 0xA
}

alias SDL_BLENDFACTOR_ZERO = SDL_BlendFactor.SDL_BLENDFACTOR_ZERO;
alias SDL_BLENDFACTOR_ONE = SDL_BlendFactor.SDL_BLENDFACTOR_ONE;
alias SDL_BLENDFACTOR_SRC_COLOR = SDL_BlendFactor.SDL_BLENDFACTOR_SRC_COLOR;
alias SDL_BLENDFACTOR_ONE_MINUS_SRC_COLOR = SDL_BlendFactor.SDL_BLENDFACTOR_ONE_MINUS_SRC_COLOR;
alias SDL_BLENDFACTOR_SRC_ALPHA = SDL_BlendFactor.SDL_BLENDFACTOR_SRC_ALPHA;
alias SDL_BLENDFACTOR_ONE_MINUS_SRC_ALPHA = SDL_BlendFactor.SDL_BLENDFACTOR_ONE_MINUS_SRC_ALPHA;
alias SDL_BLENDFACTOR_DST_COLOR = SDL_BlendFactor.SDL_BLENDFACTOR_DST_COLOR;
alias SDL_BLENDFACTOR_ONE_MINUS_DST_COLOR = SDL_BlendFactor.SDL_BLENDFACTOR_ONE_MINUS_DST_COLOR;
alias SDL_BLENDFACTOR_DST_ALPHA = SDL_BlendFactor.SDL_BLENDFACTOR_DST_ALPHA;
alias SDL_BLENDFACTOR_ONE_MINUS_DST_ALPHA = SDL_BlendFactor.SDL_BLENDFACTOR_ONE_MINUS_DST_ALPHA;

pragma(mangle, "SDL_ComposeCustomBlendMode")
SDL_BlendMode sdlComposeCustomBlendMode(
    SDL_BlendFactor srcColorFactor,
    SDL_BlendFactor dstColorFactor,
    SDL_BlendOperation colorOperation,
    SDL_BlendFactor srcAlphaFactor,
    SDL_BlendFactor dstAlphaFactor,
    SDL_BlendOperation alphaOperation);

alias SDL_ComposeCustomBlendMode = sdlComposeCustomBlendMode;
